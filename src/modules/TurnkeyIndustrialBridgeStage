if __name__ == "__main__":
    print("=== Testing Turnkey Industrial Bridge Node Deployment ===")
    
    # 1. Simulate 10,000 incoming construction node crane-stress streams
    print("\n[Step 1] Constructing mock physical construction tracking matrix...")
    mock_samples = [
        {
            "id": f"TK-CON-{idx:04d}",
            "node_type": TurnkeyNodeTypes.CONSTRUCTION,
            "data": np.random.uniform(10.0, 95.0, size=4).tolist()
        }
        for idx in range(10000)
    ]
    
    # 2. Emulate an execution worker update cycle
    class MockWorkerMetadata:
        class DistParams:
            rank = 0
            world_size = 1
        distributed_execution_params = DistParams()

    # Instantiate and spin up the node pipelines
    stage = TurnkeyIndustrialBridgeStage()
    stage.setup(MockWorkerMetadata())
    
    results = stage.process_data(mock_samples)
    critical_alerts = sum(1 for r in results if r["status"] == "Critical")
    
    print(f"\n✓ Multi-Core Preprocessor and Dual-GPU Matrix Split complete.")
    print(f"👉 Total Turnkey Records Carved: {len(results)}")
    print(f"👉 Flagged Critical Hazards    : {critical_alerts}")
